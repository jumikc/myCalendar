{
  "name": "日历",
  "short_name": "日历",
  "description": "离线可用的中文日历，含农历、节气与法定节假日。",
  "lang": "zh-CN",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#f3f4f6",
